---
// Compact newsletter card. Shown after every blog post and under the H1 on /blog.
// Submits JSON `{ email, source_path, website }` to the same-origin Pages Function
// (functions/api/subscribe.ts → D1). Config: src/config/newsletter.ts.
//
// `data-astro-reload` keeps the <ViewTransitions /> router (Layout.astro) from hijacking
// the submit and navigating to /api/subscribe; the script below handles it via fetch.
// The listener is delegated on `document`, so it survives view-transition page swaps.
//
// `website` is a honeypot: visually hidden, skipped by keyboard and screen readers.
// Bots that fill it are rejected server-side. Do not remove it.
import { newsletter } from "../config/newsletter";

interface Props {
  placement: "post" | "index";
}
const { placement } = Astro.props;
const id = `sub-${placement}`;
---

<section class:list={["sub", `sub-${placement}`]} data-sub aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`} class="sub-title">Get new essays by email</h2>
  <div class="sub-stack">
    <form
      class="sub-form"
      action={newsletter.endpoint}
      method="post"
      novalidate
      data-astro-reload
      data-sub-form
      data-honeypot={newsletter.honeypotField}
    >
      <label for={id} class="sr-only">Email address</label>
      <input
        id={id}
        class="sub-input"
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        maxlength="254"
        required
        aria-describedby={`${id}-err`}
      />
      <button type="submit" class="sub-btn">Subscribe</button>
      <div class="sub-hp" aria-hidden="true">
        <label for={`${id}-hp`}>Website</label>
        <input id={`${id}-hp`} type="text" name={newsletter.honeypotField} tabindex="-1" autocomplete="off" />
      </div>
    </form>
    <p class="sub-done" aria-live="polite"></p>
  </div>
  <p id={`${id}-err`} class="sub-err" aria-live="polite"></p>
</section>

<style>
  .sub {
    --sub-line: color-mix(in srgb, var(--color-body) 16%, transparent);
    --sub-line-strong: color-mix(in srgb, var(--color-body) 28%, transparent);
    --sub-surface: color-mix(in srgb, var(--color-body) 3%, var(--color-page));
    --sub-field: var(--color-page);
    --sub-muted: color-mix(in srgb, var(--color-body) 72%, transparent);
    max-width: 30rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-body);
    background: var(--sub-surface);
    border: 1px solid var(--sub-line);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
  }
  :global(html.dark) .sub {
    --sub-line: color-mix(in srgb, #ffffff 13%, transparent);
    --sub-line-strong: color-mix(in srgb, #ffffff 24%, transparent);
    --sub-surface: color-mix(in srgb, #ffffff 4%, var(--color-page));
    --sub-field: color-mix(in srgb, #000000 18%, var(--color-page));
  }
  .sub-post { margin-top: 3rem; margin-bottom: 1rem; }
  .sub-index { margin: -0.5rem 0 1.75rem; }

  .sub-title { margin: 0 0 0.5rem; font: inherit; font-weight: 700; color: var(--color-heading); }

  /* Form row and success line share one grid cell: crossfade without a layout jump */
  .sub-stack { display: grid; }
  .sub-stack > * { grid-area: 1 / 1; min-width: 0; transition: opacity 300ms ease; }
  .sub-done { margin: 0; align-self: center; opacity: 0; pointer-events: none; color: var(--color-heading); }
  .sub.is-done .sub-form {
    opacity: 0; pointer-events: none; visibility: hidden;
    transition: opacity 300ms ease, visibility 0s 300ms;
  }
  .sub.is-done .sub-done { opacity: 1; pointer-events: auto; }

  .sub-form { position: relative; margin: 0; display: flex; align-items: center; gap: 0.4rem; }
  .sub-input {
    font: inherit; color: var(--color-heading);
    flex: 1 1 0; width: 100%; min-width: 0;
    padding: 0.3rem 0.55rem; border-radius: 6px;
    background: var(--sub-field); border: 1px solid var(--sub-line-strong); outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .sub-input::placeholder { color: var(--color-body); opacity: 0.5; }
  .sub-input:focus { border-color: var(--color-link); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-link) 20%, transparent); }
  .sub-input[aria-invalid="true"] { border-color: color-mix(in srgb, #c0392b 55%, var(--sub-line-strong)); }
  .sub-btn {
    font: inherit; cursor: pointer; flex: none;
    padding: 0.3rem 0.75rem; border-radius: 6px;
    color: var(--color-heading); background: var(--sub-field);
    border: 1px solid var(--sub-line-strong);
    transition: border-color 160ms ease, color 160ms ease;
  }
  .sub-btn:hover { border-color: var(--color-link); color: var(--color-link); }
  .sub-btn:disabled { cursor: progress; opacity: 0.6; }
  .sub-btn:focus-visible { outline: 2px solid var(--color-link); outline-offset: 2px; }

  .sub-err { margin: 0; font-size: 0.8rem; color: var(--sub-muted); }
  .sub-err:not(:empty) { margin-top: 0.35rem; }

  /* Honeypot: off-screen and clipped (not display:none, which some bots skip) */
  .sub-hp {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0;
  }

  /* Narrow screens: full width, slightly tighter, field + button stay on one row */
  @media (max-width: 560px) {
    .sub { max-width: none; padding: 0.7rem 0.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sub-stack > *, .sub.is-done .sub-form, .sub-input, .sub-btn { transition: none; }
  }
</style>

<script>
  const MSG = {
    done: "You'll get new essays by email.",
    invalid: "That email doesn't look right.",
    limited: "Too many tries. Give it a few minutes.",
    failed: "Couldn't subscribe. Try again.",
  };
  const looksLikeEmail = (s: string) => s.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s);

  document.addEventListener("submit", async (e) => {
    const form = e.target;
    if (!(form instanceof HTMLFormElement) || !form.matches("[data-sub-form]")) return;
    e.preventDefault();
    const card = form.closest<HTMLElement>("[data-sub]");
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const button = form.querySelector("button");
    const err = card?.querySelector(".sub-err");
    const done = card?.querySelector(".sub-done");
    if (!card || !input || !button || !err || !done) return;

    const honeypotName = form.dataset.honeypot || "website";
    const honeypot = form.querySelector<HTMLInputElement>(`input[name="${honeypotName}"]`);
    const email = input.value.trim();
    const showError = (msg: string, invalid = false) => {
      err.textContent = msg;
      input.setAttribute("aria-invalid", String(invalid));
    };

    if (!looksLikeEmail(email)) return showError(MSG.invalid, true);
    showError("");
    button.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: { "content-type": "application/json", accept: "application/json" },
        body: JSON.stringify({
          email,
          source_path: location.pathname,
          [honeypotName]: honeypot?.value ?? "",
        }),
      });
      const data = await res.json().catch(() => null);
      if (res.ok && data?.ok === true) {
        done.textContent = MSG.done;
        card.classList.add("is-done");
        return;
      }
      if (data?.error === "invalid_email") showError(MSG.invalid, true);
      else if (res.status === 429) showError(MSG.limited);
      else showError(MSG.failed);
    } catch {
      showError(MSG.failed);
    }
    button.disabled = false;
  });
</script>
