---
// Newsletter subscribe card. Shown after every blog post and under the H1 on /blog.
// Provider lives in src/config/newsletter.ts.
//
// No provider configured (`action` is ""): render title, copy and the RSS line only.
// No form, no email field, no button, so nothing looks submittable and nothing can
// post to a broken URL. Once `action` is set, the real form renders and posts there.
import { newsletter } from "../config/newsletter";

interface Props {
  placement: "post" | "index";
}
const { placement } = Astro.props;
const id = `sub-${placement}`;
const hasProvider = newsletter.action.trim() !== "";
const copy =
  placement === "index"
    ? "One email when something new is out. Nothing else."
    : "I write one of these every so often. One email when the next one is out, nothing else.";
---

<section class:list={["sub", `sub-${placement}`]} data-sub aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`} class="sub-title">Get new essays by email</h2>
  {
    hasProvider ? (
      <div class="sub-stack">
        <div>
          <p class="sub-copy">{copy}</p>
          <form class="sub-form" action={newsletter.action} method="post" data-sub-form>
            <label for={id} class="sr-only">Email address</label>
            <input
              id={id}
              class="sub-input"
              type="email"
              name={newsletter.emailField}
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
            <button type="submit" class="sub-btn">Subscribe</button>
          </form>
          <p class="sub-fine">
            Or follow via <a href="/rss.xml">RSS</a>.
          </p>
        </div>
        <p class="sub-done" aria-live="polite">You'll get new essays by email.</p>
      </div>
    ) : (
      <>
        <p class="sub-copy">{copy}</p>
        <p class="sub-fine">
          Or follow via <a href="/rss.xml">RSS</a>.
        </p>
      </>
    )
  }
</section>

<style>
  .sub {
    --sub-line: color-mix(in srgb, var(--color-body) 16%, transparent);
    --sub-line-strong: color-mix(in srgb, var(--color-body) 30%, transparent);
    --sub-surface: color-mix(in srgb, var(--color-body) 3%, var(--color-page));
    --sub-field: var(--color-page);
    font-size: 0.95rem;
    color: var(--color-body);
    line-height: 1.6;
    background: var(--sub-surface);
    border: 1px solid var(--sub-line);
    border-radius: 12px;
    padding: 1.25rem 1.5rem 1.1rem;
  }
  :global(html.dark) .sub {
    --sub-line: color-mix(in srgb, #ffffff 13%, transparent);
    --sub-line-strong: color-mix(in srgb, #ffffff 26%, transparent);
    --sub-surface: color-mix(in srgb, #ffffff 4%, var(--color-page));
    --sub-field: color-mix(in srgb, #000000 18%, var(--color-page));
  }
  .sub-post { margin-top: 3.5rem; margin-bottom: 1rem; }
  .sub-index { margin: -0.25rem 0 2.25rem; }

  .sub a { color: var(--color-link); text-decoration: none; }
  .sub a:hover { text-decoration: underline; }
  .sub-title { margin: 0 0 0.25rem; font: inherit; font-size: 1rem; font-weight: 700; color: var(--color-heading); }
  .sub-copy { margin: 0.1rem 0 0.9rem; color: var(--color-body); }
  .sub-fine { margin: 0.7rem 0 0; font-size: 0.8rem; color: color-mix(in srgb, var(--color-body) 75%, transparent); }
  /* Without a form, the copy line sits directly above the RSS line */
  .sub > .sub-copy { margin-bottom: 0; }

  /* Form and success line share one grid cell so they crossfade without a layout jump */
  .sub-stack { display: grid; }
  .sub-stack > * { min-width: 0; grid-area: 1 / 1; transition: opacity 300ms ease, transform 300ms ease; }
  .sub-done { margin: 0; align-self: center; opacity: 0; transform: translateY(4px); pointer-events: none; color: var(--color-heading); }
  .sub.is-done .sub-stack > :not(.sub-done) {
    opacity: 0; transform: translateY(-4px); pointer-events: none; visibility: hidden;
    transition: opacity 300ms ease, transform 300ms ease, visibility 0s 300ms;
  }
  .sub.is-done .sub-done { opacity: 1; transform: none; pointer-events: auto; }

  .sub-form { margin: 0; display: flex; gap: 0.5rem; max-width: 30rem; }
  .sub-input {
    font: inherit; font-size: 0.9rem; color: var(--color-heading);
    flex: 1 1 0; width: 100%; min-width: 0; padding: 0.5rem 0.75rem; border-radius: 8px;
    background: var(--sub-field); border: 1px solid var(--sub-line-strong); outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .sub-input::placeholder { color: var(--color-body); opacity: 0.5; }
  .sub-input:focus { border-color: var(--color-link); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-link) 18%, transparent); }
  .sub-btn {
    font: inherit; font-size: 0.9rem; cursor: pointer; flex: none;
    padding: 0.5rem 1rem; border-radius: 8px;
    color: var(--color-heading); background: var(--sub-field);
    border: 1px solid var(--sub-line-strong);
    transition: border-color 160ms ease, color 160ms ease;
  }
  .sub-btn:hover { border-color: var(--color-link); color: var(--color-link); }
  .sub-btn:disabled { cursor: progress; }
  .sub button:focus-visible, .sub a:focus-visible { outline: 2px solid var(--color-link); outline-offset: 2px; }

  @media (max-width: 560px) {
    .sub { padding: 1.1rem; }
    .sub-form { flex-direction: column; }
    .sub-input { flex: none; }
    .sub-btn { align-self: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sub-stack > *, .sub.is-done .sub-stack > :not(.sub-done), .sub-input, .sub-btn { transition: none; }
  }
</style>

<script>
  // Only present in the DOM when a provider is configured. Sends the same FormData the
  // native form would, then crossfades to the success line. `no-cors` because providers'
  // embed endpoints don't send CORS headers: the POST still goes out, the response is just
  // opaque. A network failure rejects, in which case the form stays visible.
  document.addEventListener("submit", async (e) => {
    const form = e.target;
    if (!(form instanceof HTMLFormElement) || !form.matches("[data-sub-form]")) return;
    e.preventDefault();
    const button = form.querySelector("button");
    if (button) button.disabled = true;
    try {
      await fetch(form.action, { method: "POST", body: new FormData(form), mode: "no-cors" });
      form.closest("[data-sub]")?.classList.add("is-done");
    } catch {
      if (button) button.disabled = false;
    }
  });
</script>
