---
// Official X embed. The blockquote is a readable fallback until widgets.js
// upgrades it (and stays if scripts are blocked). Theme follows the site's mode.
interface Props {
  url: string;
  author: string;
  handle: string;
  date: string;
}
const { url, author, handle, date } = Astro.props;
---

<div class="tweet-embed not-prose my-8 flex justify-center">
  <blockquote
    class="twitter-tweet w-full max-w-[550px] rounded-lg border border-gray-300 px-5 py-4 dark:border-gray-600"
    data-dnt="true"
    data-align="center"
  >
    <p class="text-body mb-3"><slot /></p>
    <p class="text-sm opacity-70">
      — {author} (@{handle}) <a class="text-link" href={url}>{date}</a>
    </p>
  </blockquote>
</div>

<script is:inline>
  (function () {
    var dark = document.documentElement.classList.contains("dark");
    document.querySelectorAll("blockquote.twitter-tweet").forEach(function (b) {
      b.setAttribute("data-theme", dark ? "dark" : "light");
    });
    if (!document.getElementById("twitter-wjs")) {
      var s = document.createElement("script");
      s.id = "twitter-wjs";
      s.async = true;
      s.src = "https://platform.twitter.com/widgets.js";
      document.body.appendChild(s);
    }
  })();
</script>
